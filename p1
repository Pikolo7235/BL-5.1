pragma solidity ^0.8.23;

import "@openzeppelin/contracts/token/ERC721/ERC721.sol";

contract Submission is ERC721 {
    struct Haiku {
        address author;
        string line1;
        string line2;
        string line3;
    }

    uint256 public counter;
    mapping(uint256 => Haiku) private haikus;
    mapping(bytes32 => bool) private haikuHashes; // Zmieniono z line1Hashes dla całego haiku
    mapping(address => uint256[]) private sharedHaikus;
    mapping(address => mapping(uint256 => bool)) private isAlreadyShared; // Zapobiega duplikatom udostępnień

    mapping(uint256 => uint256) public votes;
    mapping(address => mapping(uint256 => bool)) private hasVoted;

    error HaikuNotUnique();
    error NotYourHaiku(uint256 tokenId);
    error NoHaikusShared();
    error AlreadyVoted();
    error HaikuDoesNotExist();
    error EmptyLine();
    error AlreadyShared();

    constructor() ERC721("HaikuNFT", "HNK") {}

    function mintHaiku(
        string memory _line1,
        string memory _line2,
        string memory _line3
    ) external {
        // Walidacja: linie nie mogą być puste
        if (bytes(_line1).length == 0 || bytes(_line2).length == 0 || bytes(_line3).length == 0) {
            revert EmptyLine();
        }

        // Hashowanie całego haiku (3 linii), aby poprawnie sprawdzać unikalność
        bytes32 haikuHash = keccak256(abi.encodePacked(_line1, _line2, _line3));
        if (haikuHashes[haikuHash]) {
            revert HaikuNotUnique();
        }
        haikuHashes[haikuHash] = true;

        uint256 id = counter;
        haikus[id] = Haiku(msg.sender, _line1, _line2, _line3);
        _mint(msg.sender, id);
        counter++;
    }

    function shareHaiku(uint256 _id, address _to) external {
        if (ownerOf(_id) != msg.sender) {
            revert NotYourHaiku(_id);
        }
        if (isAlreadyShared[_to][_id]) {
            revert AlreadyShared();
        }

        isAlreadyShared[_to][_id] = true;
        sharedHaikus[_to].push(_id);
    }

    function getMySharedHaikus() external view returns (Haiku[] memory) {
        uint256[] memory ids = sharedHaikus[msg.sender];
        uint256 len = ids.length;
        
        if (len == 0) {
            revert NoHaikusShared();
        }

        Haiku[] memory result = new Haiku[](len);
        for (uint256 i = 0; i < len; i++) {
            result[i] = haikus[ids[i]];
        }
        return result;
    }

    function vote(uint256 _id) external {
        if (_id >= counter) revert HaikuDoesNotExist(); // Naprawiono: zamiana string na Custom Error
        if (hasVoted[msg.sender][_id]) revert AlreadyVoted();
        
        hasVoted[msg.sender][_id] = true;
        votes[_id] += 1;
    }
}
